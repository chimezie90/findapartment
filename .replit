run = "python -m apartment_finder.web.app"
entrypoint = "src/apartment_finder/web/app.py"
modules = ["nix", "nodejs-20", "postgresql-16", "python-3.12", "web"]

[env]
PYTHONPATH = "${REPL_HOME}/src"

[nix]
channel = "stable-25_05"
packages = ["libyaml"]

[deployment]
run = ["python", "-m", "apartment_finder.web.app"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

# Scheduled tasks - runs twice daily at 8am and 8pm UTC
[[scheduled]]
name = "fetch-nyc-morning"
cron = "0 8 * * *"
command = "python -m apartment_finder.main --city nyc"

[[scheduled]]
name = "fetch-nyc-evening"
cron = "0 20 * * *"
command = "python -m apartment_finder.main --city nyc"

[[scheduled]]
name = "fetch-la-morning"
cron = "5 8 * * *"
command = "python -m apartment_finder.main --city la"

[[scheduled]]
name = "fetch-la-evening"
cron = "5 20 * * *"
command = "python -m apartment_finder.main --city la"

[[scheduled]]
name = "fetch-dubai-morning"
cron = "10 8 * * *"
command = "python -m apartment_finder.main --city dubai"

[[scheduled]]
name = "fetch-dubai-evening"
cron = "10 20 * * *"
command = "python -m apartment_finder.main --city dubai"

[[scheduled]]
name = "fetch-copenhagen-morning"
cron = "15 8 * * *"
command = "python -m apartment_finder.main --city copenhagen"

[[scheduled]]
name = "fetch-copenhagen-evening"
cron = "15 20 * * *"
command = "python -m apartment_finder.main --city copenhagen"

[[scheduled]]
name = "fetch-lisbon-morning"
cron = "20 8 * * *"
command = "python -m apartment_finder.main --city lisbon"

[[scheduled]]
name = "fetch-lisbon-evening"
cron = "20 20 * * *"
command = "python -m apartment_finder.main --city lisbon"

[[scheduled]]
name = "fetch-bali-morning"
cron = "25 8 * * *"
command = "python -m apartment_finder.main --city bali"

[[scheduled]]
name = "fetch-bali-evening"
cron = "25 20 * * *"
command = "python -m apartment_finder.main --city bali"

[[scheduled]]
name = "fetch-sri_lanka-morning"
cron = "30 8 * * *"
command = "python -m apartment_finder.main --city sri_lanka"

[[scheduled]]
name = "fetch-sri_lanka-evening"
cron = "30 20 * * *"
command = "python -m apartment_finder.main --city sri_lanka"

[[scheduled]]
name = "fetch-cars-copenhagen-morning"
cron = "35 8 * * *"
command = "python -m apartment_finder.main --cars --city copenhagen --no-email"

[[scheduled]]
name = "fetch-cars-copenhagen-evening"
cron = "35 20 * * *"
command = "python -m apartment_finder.main --cars --city copenhagen --no-email"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Apartment Finder"

[[workflows.workflow]]
name = "Apartment Finder"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m apartment_finder.web.app"
waitForPort = 5000
